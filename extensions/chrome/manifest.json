{
  "manifest_version": 3,
  "name": "Project Guard - Web Shield & EDR",
  "version": "1.0.0",
  "description": "Project Guard EDR Web Kalkanı: Gerçek Zamanlı Kimlik Avı (Phishing), Zararlı C2 ve Kötü Amaçlı İndirme Koruması",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Guard Web Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:7890/*",
    "http://127.0.0.1:7890/*"
  ]
}
